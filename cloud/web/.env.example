# Copy to .env.local and fill in. Gitignored: these are identifiers rather than
# secrets (they appear in every sign-in URL), but they name your tenant and app,
# so they stay out of a public repo.
#
# Vite only exposes variables prefixed VITE_ to the browser -- which is the point:
# it makes "is this shipped to the client?" a visible property of the name.
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_API_BASE=https://your-func-app.azurewebsites.net/api
