# ---- PlatformIO / build artifacts ------------------------------------------
.pio/
sdkconfig.*

# ---- Editor / tooling -------------------------------------------------------
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ---- Claude Code ------------------------------------------------------------
# The WHOLE directory, not just settings.local.json: anything the tool writes
# here is machine-local and can embed absolute paths (including the Windows
# username), captured tool output, or working notes. Ignoring the file alone
# would let any future addition slip into a public repo unnoticed.
#
# Conversation transcripts are NOT stored here -- they live per-user under
# %USERPROFILE%\.claude\projects\, outside every repository -- so they cannot be
# published by committing this project.
#
# To deliberately share project-level config later, un-ignore just that file:
#     !.claude/settings.json
.claude/
.agents/

# VS Code "Local History" extension. Ignored deliberately: it mirrors whole
# files on every save, and it contains its OWN nested .git directory, which
# would otherwise be committed as a broken pseudo-submodule.
.history/

# ---- KiCad ------------------------------------------------------------------
# Auto-generated backups and per-user state. The board, schematic, netlist,
# fab outputs and vendored footprint/symbol libraries ARE tracked, so anyone
# cloning can open the project and rebuild the gerbers.
*-backups/
*.kicad_prl
*.bak
*.kicad_pcb-bak
*.kicad_sch-bak
fp-info-cache
*.lck
*~

# ---- Python (hardware/tools) ------------------------------------------------
__pycache__/
*.py[cod]

# ---- Door state backups -----------------------------------------------------
# Output of tools/backup-doors.ps1. Contains enrolled fob credential numbers --
# anyone holding them can clone a working card -- so it must never reach a
# public repo, even by accident.
door-backup-*/
*-fobs.json

# ---- Azure / cloud deployment -----------------------------------------------
# Tenant and subscription IDs are not credentials, but they identify exactly
# which tenant to target and have no business in a public repo. The Bicep
# templates are deliberately free of them (deployment scope supplies both), so
# only these local files carry them.
cloud/infra/deploy.local.ps1
cloud/infra/entra.local.json
cloud/infra/*.parameters.json
!cloud/infra/*.parameters.example.json
.azure/
*.azureauth

# Seed data holds real fob numbers -- those ARE the credentials, so the filled-in
# copy never gets committed. Only the placeholder example is tracked.
cloud/api/seed.json
seed.json

# Anything that actually IS a secret
*.pfx
*.pem
!lib/CloudSync/**/*.pem
.env
.env.*
!.env.example
local.settings.json

# Node (cloud/api, cloud/web)
node_modules/
dist/
.func/
azure-functions-core-tools/
# Deployment bundles: build artifacts, often tens of MB, always regenerable.
deploy.zip
*.deploy.zip

# ---- OS / archive noise -----------------------------------------------------
__MACOSX/
.DS_Store
Thumbs.db
